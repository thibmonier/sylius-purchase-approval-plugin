{% extends '@SyliusCore/Email/layout.html.twig' %}

{% block subject %}{{ 'tmonier_purchase_approval.email.requested.subject'|trans({'%number%': order.number}, 'messages', localeCode)|raw }}{% endblock %}

{% block content %}
    {% include '@TmonierSyliusPurchaseApprovalPlugin/email/_summary.html.twig' %}
    <div style="text-align: center; margin-bottom: 30px;">
        {{ 'tmonier_purchase_approval.email.requested.body'|trans({'%buyer%': order.customer.fullName|default('')|trim}, 'messages', localeCode) }}
    </div>
    {% if sylius_bundle_loaded_checker('SyliusShopBundle') %}
        <div style="text-align: center; margin-bottom: 30px;">
            <a href="{{ sylius_channel_url(path('tmonier_purchase_approval_shop_approval_show', {'number': order.number, '_locale': localeCode}), channel)|raw }}" style="display: inline-block; background: #1abb9c; padding: 18px 28px; color: #fff; text-decoration: none; border-radius: 3px;">
                {{ 'tmonier_purchase_approval.email.review_order'|trans({}, 'messages', localeCode) }}
            </a>
        </div>
    {% endif %}
{% endblock %}
