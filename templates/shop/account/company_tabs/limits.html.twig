{# "My company" tab (company-accounts hook): purchase limits, for company admins. #}
{% set context = hookable_metadata.context %}
{% if is_granted('APPROVAL_LIMITS_MANAGE', context.company) %}
    {% set active = context.active_tab == 'limits' %}
    <li class="nav-item">
        <a class="nav-link {{ active ? 'active' }}" href="{{ path('tmonier_purchase_approval_shop_limits') }}" {% if active %}aria-current="page"{% endif %} {{ sylius_test_html_attribute('tmonier-limits-link') }}>{{ 'tmonier_purchase_approval.ui.purchase_limits'|trans }}</a>
    </li>
{% endif %}
